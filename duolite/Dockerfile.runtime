FROM debian:trixie-slim
RUN dpkg --add-architecture arm64 && apt-get update && apt-get install -y --no-install-recommends \
    python3 binutils zip xz-utils ca-certificates \
    weston:arm64 libgtk-3-0t64:arm64 libnss3:arm64 libasound2t64:arm64 \
    libsecret-1-0:arm64 libxss1:arm64 libxtst6:arm64 libnotify4:arm64 \
    libgbm1:arm64 libegl1:arm64 libgles2:arm64 dbus-daemon:arm64 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends seatd:arm64 && rm -rf /var/lib/apt/lists/*
